{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/ai-security-audit/main/schemas/audit.schema.json",
  "title": "Complete Audit Record",
  "description": "Top-level artifact for an audit run: metadata, detected stack, findings and the coverage ledger.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generated_at", "target", "findings", "coverage"],
  "properties": {
    "version": { "type": "string" },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root"],
      "properties": {
        "root": { "type": "string" },
        "commit": { "type": "string" },
        "scope_notes": { "type": "string" }
      }
    },
    "stack": {
      "type": "object",
      "description": "Output of detect-stack.js; left open so the recon format can evolve."
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "finding.schema.json" }
    },
    "coverage": { "$ref": "coverage.schema.json" }
  }
}
